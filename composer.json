{
    "name": "didasto/rest-api",
    "description": "Model- und Custom-REST-APIs fuer Laravel mit automatischem OpenAPI-Dokument und deklarativen Filtern.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "spatie/laravel-route-attributes": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Didasto\\RestApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Didasto\\RestApi\\RestApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
