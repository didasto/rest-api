{
    "name": "didasto/rest-api",
    "description": "Model backed and hand written REST APIs for Laravel, with an OpenAPI document generated from your request classes and declarative filters.",
    "keywords": [
        "laravel",
        "rest",
        "api",
        "openapi",
        "swagger",
        "filters",
        "jobs"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/didasto/rest-api",
    "authors": [
        {
            "name": "Florian Klöpfer",
            "email": "didasto3d@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/didasto/rest-api/issues",
        "source": "https://github.com/didasto/rest-api"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "spatie/laravel-route-attributes": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Didasto\\RestApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Didasto\\RestApi\\RestApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nikic/php-parser": "^5.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "scripts": {
        "check-vars": [
            "@php scripts/undefined-variables.php src"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "check": [
            "@check-vars",
            "@test"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Didasto\\RestApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
