# Ins Repo gehoert nur, was zum Package selbst gehoert:
# src/, config/, database/, composer.json, README, CHANGELOG und die Pipeline.

# Abhaengigkeiten - werden von Composer geholt
/vendor/

# Eine Bibliothek liefert keine composer.lock mit: die Versionen legt
# das Projekt fest, das sie einbindet.
composer.lock

# Editoren und IDEs
/.idea/
/.vscode/
/.fleet/
/.zed/
*.sublime-project
*.sublime-workspace

# Werkzeuge
/.phpunit.cache/
.phpunit.result.cache
/.php-cs-fixer.cache
/.pint.cache
/build/
/coverage/

# Betriebssystem
.DS_Store
Thumbs.db

# Von der Release-Pipeline erzeugt
release.env
